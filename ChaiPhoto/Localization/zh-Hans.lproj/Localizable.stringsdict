			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>删除 %lld 项</string>
			<key>other</key>
			<string>删除 %lld 项</string>
		</dict>
	</dict>
	<key>Deleted batches (%lld) || 實際刪除（%lld 批）</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
