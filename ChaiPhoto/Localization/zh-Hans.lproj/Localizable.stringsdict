			<string>目前选取 %lld 项准备删除</string>
		</dict>
	</dict>
	<key>Delete %lld items || 刪除 %lld 項</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
