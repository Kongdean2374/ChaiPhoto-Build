			<key>other</key>
			<string>%lld 項目を未確認に戻しました。</string>
		</dict>
	</dict>
	<key>Ready to delete %lld items || 準備刪除 %lld 項</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
