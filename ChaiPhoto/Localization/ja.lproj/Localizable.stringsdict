			<key>other</key>
			<string>削除したグループ（%lld）</string>
		</dict>
	</dict>
	<key>Moved %lld items back to review. || 已將 %lld 項移回待審。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
